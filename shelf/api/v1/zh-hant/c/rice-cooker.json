 "market": {
  "country": "JP",
  "currency": "JPY",
  "store": "Rakuten Ichiba",
  "for_visitors": "價格為日圓含稅價。樂天市場大多數店家只在日本國內出貨：在海外請選擇可國際配送的店家，或使用集運服務。在日本購買的商品，原廠保固通常只在日本有效。"
 },
 "how_to_choose": {
  "asOf": "2026-10",
  "summary": "一個人約 3 合，2–4 人約 5.5 合，5 人以上約 1 升（10 合）。價格優先選微電腦，重視口感選 IH，喜歡 Q 彈口感選壓力 IH。高價機種的差別在內鍋材質與火力。",
  "criteria": [
   {
    "name": "容量",
    "detail": "如果常煮的量只有最大容量的一半左右，選小一號的比較不容易煮不均。"
   },
   {
    "name": "加熱方式",
    "detail": "微電腦以底部加熱器加熱，價格便宜。IH 加熱整個內鍋，火力強。壓力 IH 加壓以高溫炊煮，米飯容易煮得 Q 彈。"
   },
   {
    "name": "內鍋",
    "detail": "厚釜或土鍋、鐵、銅等材質會影響蓄熱性。價格差異大多來自這裡。"
   },
   {
    "name": "清潔保養",
    "detail": "每次要洗的零件（內蓋、蒸氣口）越少，越容易持續。"
   },
   {
    "name": "保溫",
    "detail": "長時間保溫容易讓米飯變黃、變乾。打算冷凍保存的話，比起保溫性能，更該重視煮好的口感。"
   }
  ],
  "pitfalls": [
   "內鍋塗層損傷後需要花錢更換，也請先看看替換內鍋的價格。"
  ],
  "abroad": "依日本 100V 電壓設計，原廠只保證在日本使用。台灣的 110V 比額定電壓高，可能過熱或故障；220–240V 電源絕對不可使用（部分廠商另有海外專用機型）。"
 },
 "price_outlook": {
  "verdict": "cheaper_than_usual",
  "share_cheaper": 0.33,
