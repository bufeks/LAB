 "market": {
  "country": "JP",
  "currency": "JPY",
  "store": "Rakuten Ichiba, Yahoo! Shopping",
  "for_visitors": "價格為日圓含稅價。樂天市場大多數店家只在日本國內出貨：在海外請選擇可國際配送的店家，或使用集運服務。在日本購買的商品，原廠保固通常只在日本有效。"
 },
 "how_to_choose": {
  "summary": "只幫手機充電選 20–30W，也要幫筆電充電選 65W 以上。多孔充電器同時插多台裝置時，每孔的輸出會降低。",
  "criteria": [
   {
    "name": "輸出（W）",
    "detail": "iPhone 快充需要 20W 以上。筆電請選與原廠變壓器相同或更高的瓦數（例如 65W、96W）。"
   },
   {
    "name": "多孔功率分配",
    "detail": "「總計 65W」在同時充兩台時可能分成 45W+20W。要同時幫電腦和手機充電，請確認分配表。"
   },
   {
    "name": "PPS",
    "detail": "Galaxy 等手機的「超級快充」需要支援 USB PD PPS 的充電器。"
   },
   {
    "name": "GaN",
    "detail": "採用氮化鎵的充電器在相同輸出下更小更輕，常帶出門的話值得優先考慮。"
   },
   {
    "name": "傳輸線",
    "detail": "超過 60W 的供電需要支援 5A（含 e-marker 晶片）的 USB-C 線。線只支援 3A 的話，充電器瓦數再高也只能到 60W。"
   }
  ],
  "pitfalls": [
   "沒有 PSE 標章的充電器不得在日本販售，請確認標示。",
   "只比較總輸出，可能忽略單孔最大輸出不足。"
  ],
  "abroad": "在日本販售的 USB-C 充電器大多支援 100–240V 輸入，搭配轉接頭可在海外使用（日本為 A 型雙扁腳插頭）。請確認標籤上有「100-240V」。"
 },
