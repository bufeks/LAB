 "market": {
  "country": "JP",
  "currency": "JPY",
  "store": "Rakuten Ichiba",
  "for_visitors": "價格為日圓含稅價。樂天市場大多數店家只在日本國內出貨：在海外請選擇可國際配送的店家，或使用集運服務。在日本購買的商品，原廠保固通常只在日本有效。"
 },
 "how_to_choose": {
  "asOf": "2026-10",
  "summary": "吹乾速度幾乎取決於風量（m³/分鐘）。頭髮長或髮量多選大風量機型，在意髮質受損選有溫度切換的。負離子類功能的使用感受差異大，難以用數字比較。",
  "criteria": [
   {
    "name": "風量",
    "detail": "一般機型約 1.3–1.5m³/分鐘，大風量機型約 2m³/分鐘。風量越大，吹乾時間越短，吹熱風的時間也越少。"
   },
   {
    "name": "溫度切換",
    "detail": "風太熱會傷頭髮和頭皮。有低溫模式或冷熱切換，可在吹整收尾或夏天時切換使用。"
   },
   {
    "name": "重量・造型",
    "detail": "每天都要用，拿在手上的重量與平衡大大影響滿意度。要收納的話選可折疊式。"
   },
   {
    "name": "負離子類功能",
    "detail": "nanoe（奈米水離子）等是各廠商的獨家功能，效果感受因人而異。先比較風量與溫度控制，附加功能依喜好選擇。"
   },
   {
    "name": "消耗功率",
    "detail": "多為 1200W 級，和其他家電同時使用可能會跳電。"
   }
  ],
  "pitfalls": [
   "進風口積灰塵會讓風量下降，也可能造成過熱，請定期清潔。",
   "把電線纏繞在機身上收納，容易造成斷線。"
  ],
  "abroad": "依日本 100V 電壓設計，原廠只保證在日本使用。台灣的 110V 比額定電壓高，可能過熱或故障；220–240V 電源絕對不可使用。"
 },
