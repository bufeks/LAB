 "how_to_choose": {
  "asOf": "2026-10",
  "summary": "百靈 Oral-B 的圓形替換刷頭，可用於 iO 系列以外的旋轉式主機（iO 只能用專用刷頭，橢圓形刷頭適用其他機型）。比較時看每支價格。約每 3 個月更換一次。",
  "criteria": [
   {
    "name": "與主機的相容性",
    "detail": "根據廠商說明，替換刷頭可裝在百靈（Oral-B）電動牙刷主機上，但 iO 系列有專用替換刷頭，不相容。圓形與橢圓形對應的主機不同。"
   },
   {
    "name": "每支價格",
    "detail": "數量不同，請用支數換算比較。"
   },
   {
    "name": "刷頭種類",
    "detail": "有去除牙菌斑、美白、軟毛等種類。牙齦較敏感的人請選軟毛款。"
   },
   {
    "name": "原廠或副廠",
    "detail": "這裡只比較原廠品。副廠品便宜，但可能無法享有原廠保固。"
   }
  ],
  "pitfalls": [
   "刷頭根部的彩色刷毛變淡，就是該更換的提示（限有指示刷毛的刷頭）。"
  ],
  "abroad": "在任何地方都能用於相同的主機。"
 },
