 "market": {
  "country": "JP",
  "currency": "JPY",
  "store": "Rakuten Ichiba",
  "for_visitors": "價格為日圓含稅價。樂天市場大多數店家只在日本國內出貨：在海外請選擇可國際配送的店家，或使用集運服務。在日本購買的商品，原廠保固通常只在日本有效。"
 },
 "how_to_choose": {
  "summary": "一個人約 0.8L，家庭 1.0–1.2L。家中有小孩的，優先選「傾倒防漏」與雙層機身。手沖咖啡選可調溫且細口壺嘴的。",
  "criteria": [
   {
    "name": "容量",
    "detail": "一杯約 140–200ml：0.8L 可裝 4–5 杯，1.2L 可裝 6–8 杯。容量過大，煮沸需要更久。"
   },
   {
    "name": "安全功能",
    "detail": "防空燒是大多數產品的標配。「傾倒防漏」與外殼不燙手的雙層結構則因產品而異。"
   },
   {
    "name": "溫度調節",
    "detail": "咖啡約 90–96℃，綠茶約 70–80℃。可設定溫度的話，泡茶、沖咖啡和泡奶都能兼顧。"
   },
   {
    "name": "壺嘴",
    "detail": "手沖咖啡適合細長的鵝頸壺嘴，日常使用一般壺嘴就夠了。"
   },
   {
    "name": "功率",
    "detail": "多為 1200–1300W，煮水快，但和微波爐或吹風機同時使用容易跳電。"
   }
  ],
  "pitfalls": [
   "內膽為塑膠的產品可能有異味，介意的話請選不鏽鋼內膽。"
  ],
  "abroad": "依日本 100V 電壓設計，原廠只保證在日本使用。台灣的 110V 比額定電壓高，可能過熱或故障；220–240V 電源絕對不可使用。"
 },
 "price_outlook": {
