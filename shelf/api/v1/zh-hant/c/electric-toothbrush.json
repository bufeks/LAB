 },
 "how_to_choose": {
  "summary": "長期來看，替換刷頭（約每 3 個月換一次）的花費比主機更多。擔心刷太用力就選有壓力感應的，擔心刷不乾淨就選有計時的。",
  "criteria": [
   {
    "name": "類型",
    "detail": "音波式讓刷毛高速振動，沿著牙面移動；旋轉式是圓形刷頭來回旋轉，一顆一顆刷。哪種比較好取決於個人喜好與習慣。"
   },
   {
    "name": "壓力感應",
    "detail": "太用力容易傷到牙齦和牙齒，有提醒功能比較安心。"
   },
   {
    "name": "計時",
    "detail": "兩分鐘計時加上每 30 秒提示換區域，可以減少漏刷。"
   },
   {
    "name": "替換刷頭",
    "detail": "一般約 3 個月換一次。比較時把原廠刷頭單價 × 每年 4 支加到主機價格上。"
   }
  ],
  "pitfalls": [
   "副廠刷頭便宜，但可能無法享有原廠保固。"
  ],
  "abroad": "在日本販售的許多充電器只支援 100V，也有支援 100–240V 的。在海外使用前請確認充電器標籤。"
 },
