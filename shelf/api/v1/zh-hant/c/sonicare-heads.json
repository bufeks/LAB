 "how_to_choose": {
  "asOf": "2026-10",
  "summary": "卡扣式的 Sonicare 替換刷頭，幾乎所有 Sonicare 充電式主機都能使用（Philips One 與舊款 Essence 除外）。比較時看每支價格。約每 3 個月更換一次。",
  "criteria": [
   {
    "name": "與主機的相容性",
    "detail": "根據廠商說明，標準卡扣式刷頭可用於幾乎所有 Sonicare 充電式電動牙刷。Philips One 只能用專用刷頭，舊款 Essence 為旋入式。"
   },
   {
    "name": "每支價格",
    "detail": "有 2 支、4 支、8 支裝等不同數量，請用支數換算比較。大包裝通常較划算。"
   },
   {
    "name": "刷頭種類",
    "detail": "有去除牙菌斑、美白、牙齦護理等不同用途的種類。日常使用選標準款就夠了。"
   },
   {
    "name": "原廠或副廠",
    "detail": "這裡只比較原廠品。副廠品便宜，但可能無法享有原廠保固。"
   }
  ],
  "pitfalls": [
   "刷毛開始外翻時，不必等到 3 個月就該更換。",
   "不知道主機型號時，請查看主機底部或使用說明書。"
  ],
  "abroad": "在任何地方都能用於相同的主機。"
 },
