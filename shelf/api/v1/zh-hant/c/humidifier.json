 "market": {
  "country": "JP",
  "currency": "JPY",
  "store": "Rakuten Ichiba, Yahoo! Shopping",
  "for_visitors": "價格為日圓含稅價。樂天市場大多數店家只在日本國內出貨：在海外請選擇可國際配送的店家，或使用集運服務。在日本購買的商品，原廠保固通常只在日本有效。"
 },
 "how_to_choose": {
  "summary": "類型決定一切。重視衛生選加熱式（電費較高），重視電費選汽化式，重視體積和價格選超音波式（前提是勤清潔）。適用坪數請選比房間大一級的。",
  "criteria": [
   {
    "name": "加熱式（蒸氣）",
    "detail": "把水煮沸，不易孳生細菌，加濕力強。耗電數百瓦，部分產品出風口較燙。"
   },
   {
    "name": "汽化式",
    "detail": "以風吹過濕濾網，耗電低、安靜。加濕力受室溫與濕度影響，濾網需要定期清潔與更換。"
   },
   {
    "name": "超音波式",
    "detail": "便宜、小巧、安靜。直接把水霧化，水箱不清潔會把細菌噴出來；自來水中的礦物質可能產生白色粉末。"
   },
   {
    "name": "混合式",
    "detail": "在汽化式或超音波式加上加熱器，兼顧加濕力與耗電。價格偏高。"
   },
   {
    "name": "適用坪數",
    "detail": "會標示「木造和室 X 疊 / 預鑄洋室 X 疊」兩個數字，木造和室的數字較小。請依與住處相符的那個比較。"
   }
  ],
  "pitfalls": [
   "先確認替換濾網的價格與是否好買（使用成本）。",
   "水箱口窄不好清洗，會影響衛生。"
  ],
  "abroad": "依日本 100V 電壓設計，原廠只保證在日本使用。台灣的 110V 比額定電壓高，可能過熱或故障；220–240V 電源絕對不可使用。"
 },
