 "market": {
  "country": "JP",
  "currency": "JPY",
  "store": "Rakuten Ichiba",
  "for_visitors": "價格為日圓含稅價。樂天市場大多數店家只在日本國內出貨：在海外請選擇可國際配送的店家，或使用集運服務。在日本購買的商品，原廠保固通常只在日本有效。"
 },
 "how_to_choose": {
  "asOf": "2026-09",
  "summary": "日常使用選 10000mAh、20W 以上；也要幫筆電充電選 20000mAh、45W 以上。在日本販售的行動電源必須有 PSE 標章。搭飛機只能隨身攜帶，超過 100Wh 需航空公司核准，許多航空公司禁止在機上使用或充電。",
  "criteria": [
   {
    "name": "容量（mAh）",
    "detail": "因電壓轉換損耗，標示容量中實際能充進手機的約 6–7 成。10000mAh 約可為一般手機充 1.5–2 次。"
   },
   {
    "name": "輸出（W）",
    "detail": "iPhone 快充需要 USB PD 20W 以上。筆電需要接近原廠變壓器的瓦數（45–65W 以上）。"
   },
   {
    "name": "重量",
    "detail": "10000mAh 級約 180–250g，20000mAh 級約 300–450g。要隨身帶的話，先依重量篩選，再看容量。"
   },
   {
    "name": "PSE 標章",
    "detail": "自 2019 年 2 月起，沒有 PSE 標章的行動電源不得在日本販售（《電氣用品安全法》）。避免選擇未標示的商品。"
   },
   {
    "name": "搭飛機",
    "detail": "不可託運，只能隨身攜帶。一般規定：100Wh 以下無需核准，超過 100Wh 且不超過 160Wh 需航空公司核准（通常最多 2 個），超過 160Wh 禁止攜帶。2025 年以來，越來越多航空公司禁止在機上使用或充電，或限制攜帶數量；日本國內線要求放在身邊而非行李櫃。請確認機身上的 Wh 標示（20000mAh 約 74Wh，27000mAh 級約 100Wh，需確認），並以所搭航空公司的最新規定為準。"
   }
  ],
  "pitfalls": [
   "價格遠低於行情的大容量產品，容量標示可能灌水。",
   "出現膨脹、發熱或異味時立即停用，交給當地政府或 JBRC 合作店回收（不要當一般垃圾丟）。"
  ],
  "abroad": "在任何地方都能用（USB）。帶回國時必須隨身攜帶登機，請確認機身上的 Wh 標示。"
 },
 "price_outlook": {
  "verdict": "cheaper_than_usual",
  "share_cheaper": 0.33,
  "share_pricier": 0,
  "judged_items": 6,
  "window_days": 31,
  "summary": "排名前面的商品中 33% 比平常便宜。現在買是不錯的時機。（已觀測 31 天，尚未反映季節變化）"
 },
 "method": {
  "summary": "每個類別依評價數從樂天取得最多 60 項商品，依排除字詞、價格區間與最低評價數篩選。不同店家販售的同一商品（型號相同，或規格相同且名稱幾乎一致）合併為評分最高的一項，其他店家的價格保留在 other_offers。其餘依「貝氏平均評分」排序。",
  "formula": "score = (C × m + n × r) / (C + n)  … r = 該商品平均評分，n = 評價數，m = 所有候選商品的平均評分，C = 50",
  "why": "讓有數千則評價的 4.4★ 排在只有幾則評價的 5★ 之前。評價越少，評分越被拉向整體平均。",
  "picks": {
   "best": "分數第一",
   "budget": "分數前 40% 的商品中價格最低",
   "deal": "價格低於平常的商品中，低於中位價幅度最大的一項（排除異常值與可選規格的商品）"
  },
  "priceVerdict": "每天記錄價格，只與運費條件相同的日子比較。觀測不足 7 天為 insufficient_data；為觀測期間最低價且比中位價低 3% 以上為 lowest_observed；不高於中位價的 90% 為 below_usual；不低於 110% 為 above_usual；其餘為 usual。觀測期間最長 90 天，天數見 window_days。",
  "caveat": "規格是從商品名稱機械式擷取的參考值，可能有誤。購買前請在商品頁面確認。"
 },
