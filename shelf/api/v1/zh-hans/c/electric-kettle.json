 "market": {
  "country": "JP",
  "currency": "JPY",
  "store": "Rakuten Ichiba",
  "for_visitors": "价格为日元含税价。乐天市场的大多数店铺只在日本国内发货：在海外请选择支持国际配送的店铺，或使用转运服务。在日本购买的商品，厂家保修往往只在日本有效。"
 },
 "how_to_choose": {
  "summary": "一个人约 0.8L，家庭 1.0–1.2L。家里有小孩的，优先选“倾倒防漏”和双层机身。手冲咖啡选可调温且细长壶嘴的。",
  "criteria": [
   {
    "name": "容量",
    "detail": "一杯约 140–200ml：0.8L 可装 4–5 杯，1.2L 可装 6–8 杯。容量过大，烧开需要更久。"
   },
   {
    "name": "安全功能",
    "detail": "防干烧是大多数产品的标配。“倾倒防漏”和外壳不烫手的双层结构则因产品而异。"
   },
   {
    "name": "温度调节",
    "detail": "咖啡约 90–96℃，绿茶约 70–80℃。可设定温度的话，泡茶、冲咖啡和冲奶粉都能兼顾。"
   },
   {
    "name": "壶嘴",
    "detail": "手冲咖啡适合细长的鹅颈壶嘴，日常使用普通壶嘴就足够。"
   },
   {
    "name": "功率",
    "detail": "多为 1200–1300W，烧水快，但与微波炉或吹风机同时使用容易跳闸。"
   }
  ],
  "pitfalls": [
   "内胆为塑料的产品可能有异味，介意的话请选不锈钢内胆。"
  ],
  "abroad": "按日本 100V 电压设计，厂家只支持在日本使用。110–120V 高于额定电压，可能过热或损坏；绝对不要在 220–240V 电源上使用。"
 },
 "price_outlook": {
