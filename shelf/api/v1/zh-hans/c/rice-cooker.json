 "market": {
  "country": "JP",
  "currency": "JPY",
  "store": "Rakuten Ichiba",
  "for_visitors": "价格为日元含税价。乐天市场的大多数店铺只在日本国内发货：在海外请选择支持国际配送的店铺，或使用转运服务。在日本购买的商品，厂家保修往往只在日本有效。"
 },
 "how_to_choose": {
  "asOf": "2026-10",
  "summary": "一个人住约 3 合，2–4 人约 5.5 合，5 人以上约 1 升（10 合）。价格优先选微电脑式，重视煮出来的口感选 IH，喜欢软糯口感选压力 IH。高价位产品的差别在于内胆材质和火力。",
  "criteria": [
   {
    "name": "容量",
    "detail": "如果经常只煮最大容量的一半左右，选小一档的更不容易煮得不均匀。"
   },
   {
    "name": "加热方式",
    "detail": "微电脑式用底部加热盘加热，价格便宜。IH 加热整个内胆，火力强。压力 IH 加压高温煮饭，口感更软糯。"
   },
   {
    "name": "内胆",
    "detail": "厚釜或土锅、铁、铜等材质会影响蓄热性。价格差异大多来自这里。"
   },
   {
    "name": "清洁",
    "detail": "每次要洗的部件（内盖、蒸汽口）越少，越容易坚持。"
   },
   {
    "name": "保温",
    "detail": "长时间保温容易让米饭发黄、变干。如果习惯冷冻保存，比起保温性能，更应重视煮出来的口感。"
   }
  ],
  "pitfalls": [
   "内胆涂层损坏后需要付费更换，请事先看看替换内胆的价格。"
  ],
  "abroad": "按日本 100V 电压设计，厂家只支持在日本使用，绝对不要在 220–240V 电源上使用。部分厂家另有面向海外的型号。"
 },
 "price_outlook": {
