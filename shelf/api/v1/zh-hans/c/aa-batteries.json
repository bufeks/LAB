 "how_to_choose": {
  "asOf": "2026-10",
  "summary": "比较时看每节价格。遥控器、时钟等低功耗设备，便宜的大包装就够用；相机、玩具等耗电大的设备，也可以考虑高性能电池或充电电池。",
  "criteria": [
   {
    "name": "每节价格",
    "detail": "有 4 节、20 节、40 节等不同规格，用节数除出单价来比较。"
   },
   {
    "name": "建议使用期限",
    "detail": "从生产起可保存期限的参考。用于储备的话选期限长的，并在期限内轮换使用。"
   },
   {
    "name": "用途",
    "detail": "耗电大的设备（游戏手柄、相机闪光灯等）电池消耗快。经常更换的话，长期来看充电电池可能更便宜。"
   },
   {
    "name": "漏液",
    "detail": "用完的电池以及长期不用的设备里的电池最好取出，可防止漏液造成损坏。"
   }
  ],
  "pitfalls": [
   "不要把新旧电池或不同种类的电池混用。",
   "丢弃时用胶带把电极绝缘，并按当地的垃圾分类规定处理。"
  ],
  "abroad": "碱性电池可以放在行李中带上飞机，请遵守所乘航空公司的规定。"
 },
