  "for_visitors": "价格为日元含税价。乐天市场的大多数店铺只在日本国内发货：在海外请选择支持国际配送的店铺，或使用转运服务。在日本购买的商品，厂家保修往往只在日本有效。"
 },
 "how_to_choose": {
  "asOf": "2026-10",
  "summary": "有构建房间地图的功能，漏扫更少，还能按房间指定清扫。想省事选带自动集尘的。各厂家吸力（Pa）的测量方法不统一，数值仅供参考。",
  "criteria": [
   {
    "name": "地图构建",
    "detail": "用 LiDAR（激光）或摄像头构建房间地图的机型，行走效率高，可以设置禁区或按房间清扫。"
   },
   {
    "name": "机身高度",
    "detail": "想清扫沙发和床底的话，比较家具下方的空隙和机身高度。"
   },
   {
    "name": "自动集尘",
    "detail": "由充电座吸走垃圾的机型，几周倒一次垃圾即可。底座较大，并需要购买集尘袋。"
   },
   {
    "name": "拖地",
    "detail": "以木地板为主的家庭很方便。家里有地毯的，请确认是否有抬起拖布的功能。"
   },
   {
    "name": "耗材",
    "detail": "确认刷子、滤网、集尘袋的更换费用和是否容易买到。"
   }
  ],
  "pitfalls": [
   "可能卷入地上的电线或小物件，使用前需要养成整理地面的习惯。",
   "依赖手机 App 的机型，厂家停止服务后相关功能可能无法使用。"
  ],
  "abroad": "在日本以外使用前，请确认充电座的电源适配器是否支持 100–240V 输入（标签上有标注）。"
 },
