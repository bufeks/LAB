  "for_visitors": "价格为日元含税价。乐天市场的大多数店铺只在日本国内发货：在海外请选择支持国际配送的店铺，或使用转运服务。在日本购买的商品，厂家保修往往只在日本有效。"
 },
 "how_to_choose": {
  "asOf": "2026-10",
  "summary": "适用面积按使用房间的 2–3 倍来选，净化更快，也能以安静的档位运行。带加湿功能的方便，但清洁工作会增加。比较时不要只看机身价格，还要算上更换滤网的费用。",
  "criteria": [
   {
    "name": "适用面积",
    "detail": "按日本电机工业会的标准（JEM1467），标示的是 30 分钟内能清除规定量粉尘的面积。选得比房间越大，净化越快。"
   },
   {
    "name": "滤网",
    "detail": "HEPA 类集尘滤网能很好地捕捉细小颗粒。“10 年无需更换”等标示是试验条件下的参考值，实际可能因使用情况而缩短。"
   },
   {
    "name": "加湿功能",
    "detail": "一台搞定，但需要清洁加湿托盘和滤网。疏于清洁会带来卫生问题。"
   },
   {
    "name": "运行噪音",
    "detail": "在卧室使用的话，请确认静音模式的噪音值（dB）。"
   },
   {
    "name": "使用成本",
    "detail": "把替换滤网的价格、更换周期和电费加起来比较。"
   }
  ],
  "pitfalls": [
   "兼容滤网便宜，但性能和安全性可能没有保证。"
  ],
  "abroad": "按日本 100V 电压设计，厂家只支持在日本使用。绝对不要在 220–240V 电源上使用。"
 },
 "price_outlook": {
  "verdict": "cheaper_than_usual",
