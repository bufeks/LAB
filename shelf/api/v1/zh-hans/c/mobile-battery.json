 "market": {
  "country": "JP",
  "currency": "JPY",
  "store": "Rakuten Ichiba",
  "for_visitors": "价格为日元含税价。乐天市场的大多数店铺只在日本国内发货：在海外请选择支持国际配送的店铺，或使用转运服务。在日本购买的商品，厂家保修往往只在日本有效。"
 },
 "how_to_choose": {
  "asOf": "2026-09",
  "summary": "日常使用选 10000mAh、20W 以上；还要给笔记本电脑充电选 20000mAh、45W 以上。在日本销售的充电宝必须有 PSE 标志。乘飞机只能随身携带，超过 100Wh 需航空公司批准，很多航空公司禁止在机上使用或充电。",
  "criteria": [
   {
    "name": "容量（mAh）",
    "detail": "由于电压转换损耗，标称容量中实际能充进手机的约为 6–7 成。10000mAh 大约能给一般手机充 1.5–2 次。"
   },
   {
    "name": "输出（W）",
    "detail": "iPhone 快充需要 USB PD 20W 以上。笔记本电脑需要接近原装适配器的功率（45–65W 以上）。"
   },
   {
    "name": "重量",
    "detail": "10000mAh 级约 180–250g，20000mAh 级约 300–450g。要随身带的话，先按重量筛选，再看容量。"
   },
   {
    "name": "PSE 标志",
    "detail": "自 2019 年 2 月起，没有 PSE 标志的充电宝不得在日本销售（《电气用品安全法》）。避免选择未标注的商品。"
   },
   {
    "name": "乘飞机",
    "detail": "不可托运，只能随身携带。一般规定：100Wh 以下无需批准，超过 100Wh 且不超过 160Wh 需航空公司批准（通常最多 2 个），超过 160Wh 禁止携带。2025 年以来，越来越多航空公司禁止在机上使用或充电，或限制携带数量；日本国内航班要求放在身边而不是行李架上。请查看机身上的 Wh 标注（20000mAh 约 74Wh，27000mAh 级在 100Wh 左右，需确认），并以所乘航空公司的最新规定为准。"
   }
  ],
  "pitfalls": [
   "价格远低于市场的大容量产品，容量标注可能虚高。",
   "出现鼓包、发热或异味时立即停用，交给当地政府或 JBRC 合作店回收（不要当普通垃圾扔）。"
  ],
  "abroad": "在任何地方都能用（USB）。带回国时必须随身携带登机，请确认机身上的 Wh 标注。"
 },
