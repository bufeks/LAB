 "market": {
  "country": "JP",
  "currency": "JPY",
  "store": "Rakuten Ichiba",
  "for_visitors": "价格为日元含税价。乐天市场的大多数店铺只在日本国内发货：在海外请选择支持国际配送的店铺，或使用转运服务。在日本购买的商品，厂家保修往往只在日本有效。"
 },
 "how_to_choose": {
  "summary": "类型决定一切。重视卫生选加热式（电费较高），重视电费选蒸发式，重视体积和价格选超声波式（前提是勤清洁）。适用面积请选比房间大一档的。",
  "criteria": [
   {
    "name": "加热式（蒸汽）",
    "detail": "把水烧开，不易滋生细菌，加湿能力强。耗电数百瓦，部分产品出风口较烫。"
   },
   {
    "name": "蒸发式",
    "detail": "用风吹湿滤网，耗电低、安静。加湿能力受室温和湿度影响，滤网需要定期清洁和更换。"
   },
   {
    "name": "超声波式",
    "detail": "便宜、小巧、安静。直接把水雾化，水箱不清洁会把细菌喷出来；自来水中的矿物质可能产生白色粉末。"
   },
   {
    "name": "混合式",
    "detail": "在蒸发式或超声波式上加入加热器，兼顾加湿能力和耗电。价格偏高。"
   },
   {
    "name": "适用面积",
    "detail": "会标出“木造和室 X 叠 / 预制洋室 X 叠”两个数字，木造和室的数字更小。请按与住所相符的那个比较。"
   }
  ],
  "pitfalls": [
   "先确认替换滤网的价格和是否好买（使用成本）。",
   "水箱口窄不好清洗，会影响卫生。"
  ],
  "abroad": "按日本 100V 电压设计，厂家只支持在日本使用。110–120V 高于额定电压，可能过热或损坏；绝对不要在 220–240V 电源上使用。"
 },
