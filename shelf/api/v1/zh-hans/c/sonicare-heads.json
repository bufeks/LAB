 "how_to_choose": {
  "asOf": "2026-10",
  "summary": "卡入式 Sonicare 替换刷头可用于大多数 Sonicare 充电式主机（Philips One 和旧款 Essence 除外）。比较时看每个刷头的价格。一般约 3 个月更换一次。",
  "criteria": [
   {
    "name": "与主机的兼容性",
    "detail": "据厂家说明，标准卡入式刷头可用于大多数 Sonicare 充电式牙刷。Philips One 只能用专用刷头，旧款 Essence 为旋入式。"
   },
   {
    "name": "每个刷头的价格",
    "detail": "有 2 个、4 个、8 个装等不同规格，用个数除出单价来比较。大包装往往更划算。"
   },
   {
    "name": "刷头种类",
    "detail": "有清除牙菌斑、美白、牙龈护理等不同用途的种类。日常使用标准款就足够。"
   },
   {
    "name": "原装还是兼容",
    "detail": "这里只比较原装产品。兼容刷头便宜，但可能不在厂家保修范围内。"
   }
  ],
  "pitfalls": [
   "刷毛开始散开时，不必等满 3 个月就应更换。",
   "不知道主机型号时，可在主机底部或使用说明书中确认。"
  ],
  "abroad": "在任何地方都能装在同一主机上使用。"
