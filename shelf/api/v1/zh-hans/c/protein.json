 "how_to_choose": {
  "asOf": "2026-10",
  "summary": "比较时看每公斤价格。但各产品的蛋白质含量（多为 70–90%）不同，请同时通过营养成分表确认每份的蛋白质量。",
  "criteria": [
   {
    "name": "每公斤价格",
    "detail": "有 1kg、3kg、1kg×2 等不同规格，用总量除出单价来比较。大包装往往更划算。"
   },
   {
    "name": "种类",
    "detail": "乳清来自牛奶，吸收快。WPI 是去除了乳糖、纯度更高的乳清，适合容易拉肚子的人。大豆蛋白来自大豆，吸收较慢。"
   },
   {
    "name": "蛋白质含量",
    "detail": "同样 1kg，蛋白质含量因产品而异。根据每份蛋白质量和价格，算出每克蛋白质的费用来比较最公平。"
   },
   {
    "name": "甜味剂与添加剂",
    "detail": "也有面向想避免人工甜味剂人群的无添加、原味产品。口味较差，但也方便用于烹饪。"
   }
  ],
  "pitfalls": [
   "运动员需注意可能混入兴奋剂检测对象成分的风险，请确认是否有第三方认证（如 Informed Choice）。",
   "有慢性病或蛋白质摄入受限的人请咨询医生。"
  ],
  "abroad": "很多国家和地区对携带营养补充剂（含乳制品成分的产品等）入境有限制，请事先确认目的地的进口规定。"
 },
