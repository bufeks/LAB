 "market": {
  "country": "JP",
  "currency": "JPY",
  "store": "Rakuten Ichiba",
  "for_visitors": "价格为日元含税价。乐天市场的大多数店铺只在日本国内发货：在海外请选择支持国际配送的店铺，或使用转运服务。在日本购买的商品，厂家保修往往只在日本有效。"
 },
 "how_to_choose": {
  "summary": "只给手机充电选 20–30W，还要给笔记本电脑充电选 65W 以上。多口充电器同时插多台设备时，每个接口的输出会下降。",
  "criteria": [
   {
    "name": "输出（W）",
    "detail": "iPhone 快充需要 20W 以上。笔记本电脑请选与原装适配器相同或更高的功率（例如 65W、96W）。"
   },
   {
    "name": "多口功率分配",
    "detail": "“总计 65W”在同时充两台设备时可能分成 45W+20W。要同时给电脑和手机充电，请确认分配表。"
   },
   {
    "name": "PPS",
    "detail": "Galaxy 等手机的“超级快充”需要支持 USB PD PPS 的充电器。"
   },
   {
    "name": "GaN",
    "detail": "采用氮化镓的充电器在相同输出下更小更轻，经常携带的话值得优先考虑。"
   },
   {
    "name": "数据线",
    "detail": "超过 60W 的供电需要支持 5A（带 e-marker 芯片）的 USB-C 线。如果线只支持 3A，即使充电器功率高也只能到 60W。"
   }
  ],
  "pitfalls": [
   "没有 PSE 标志的充电器不得在日本销售，请确认标注。",
   "只比较总输出，可能忽略单个接口的最大输出不够。"
  ],
  "abroad": "在日本销售的 USB-C 充电器大多支持 100–240V 输入，配合转换插头可在海外使用（日本为 A 型两扁脚插头）。请确认标签上有“100-240V”。"
 },
