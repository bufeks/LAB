 "market": {
  "country": "JP",
  "currency": "JPY",
  "store": "Rakuten Ichiba",
  "for_visitors": "Prices are in Japanese yen, tax included. Most Rakuten Ichiba shops ship only within Japan: from abroad, look for a shop that ships internationally or use a forwarding service. Manufacturer warranties on products bought in Japan are often valid only in Japan."
 },
 "how_to_choose": {
  "summary": "About 0.8 L for one person, 1.0–1.2 L for a family. With small children, prioritise tip-over spill protection and a double-walled body. For pour-over coffee, temperature control and a gooseneck spout.",
  "criteria": [
   {
    "name": "Capacity",
    "detail": "A cup is about 140–200 ml: 0.8 L makes 4–5 cups, 1.2 L makes 6–8. A kettle much bigger than you need takes longer to boil."
   },
   {
    "name": "Safety",
    "detail": "Boil-dry protection is standard on most models. Tip-over spill protection and a double-walled body that stays cool vary between products."
   },
   {
    "name": "Temperature control",
    "detail": "About 90–96 °C for coffee and 70–80 °C for green tea. Setting the temperature lets one kettle serve tea, coffee and baby formula."
   },
   {
    "name": "Spout",
    "detail": "A narrow gooseneck spout suits pour-over coffee. For everyday use, a regular spout is fine."
   },
   {
    "name": "Power",
    "detail": "Most are 1200–1300 W and boil quickly, but running one together with a microwave or hair dryer can trip the breaker."
   }
  ],
  "pitfalls": [
   "Plastic interiors can leave a smell. If that bothers you, choose a stainless steel interior."
  ],
  "abroad": "Made for Japan’s 100 V mains, and the manufacturer supports use in Japan only. 110–120 V is above its rating and can cause overheating or failure; never use it on 220–240 V."
 },
 "price_outlook": {
  "verdict": "usual",
  "share_cheaper": 0.17,
