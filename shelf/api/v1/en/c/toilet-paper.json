  "store": "Rakuten Ichiba",
  "for_visitors": "Prices are in Japanese yen, tax included. Most Rakuten Ichiba shops ship only within Japan: from abroad, look for a shop that ships internationally or use a forwarding service. Manufacturer warranties on products bought in Japan are often valid only in Japan."
 },
 "how_to_choose": {
  "asOf": "2026-10",
  "summary": "Single-ply and double-ply cannot be compared simply by length (double-ply is two sheets). Here double-ply length is doubled and prices are compared per 100 m single-ply equivalent. Long rolls mean fewer changes and less storage space.",
  "criteria": [
   {
    "name": "Unit price, single-ply equivalent",
    "detail": "Double-ply is two sheets, so its paper equals twice the length of single-ply. Work out the total as rolls × length × (2 for double-ply) and compare."
   },
   {
    "name": "Long rolls",
    "detail": "“2× length” and “3× length” rolls cut the effort of changing rolls and the storage space. The roll is wider, so check that it fits your holder."
   },
   {
    "name": "Softness",
    "detail": "100% pulp is softer; recycled paper is cheaper and has a lower environmental impact."
   },
   {
    "name": "Storage",
    "detail": "Bulk packs are cheaper but need somewhere to go. Consider the size of the box that arrives."
   }
  ],
  "pitfalls": [
   "Listings without a roll length cannot have a unit price calculated, so they are left out of the unit-price ranking."
  ],
  "abroad": "No special issue, but it is bulky, so it is mostly useful for people living in Japan."
 },
 "price_outlook": {
  "verdict": "cheaper_than_usual",
  "share_cheaper": 0.33,
  "share_pricier": 0,
  "judged_items": 6,
  "window_days": 31,
  "summary": "33% of the top products are cheaper than usual. Not a bad time to buy. (31 days observed; seasonal patterns not yet reflected)"
 },
 "method": {
  "summary": "For each category, up to 60 Rakuten listings are fetched in order of review count and filtered by excluded words, price range and a minimum number of reviews. Listings of the same product by different shops (same model number, or the same specs and a near-identical title) are merged into the best-rated one, with the other shops’ prices kept in other_offers. The rest are ranked by a Bayesian average rating.",
  "formula": "score = (C × m + n × r) / (C + n)  … r = the product’s average rating, n = number of reviews, m = average rating of all candidates, C = 50",
  "why": "So that a 4.4★ with thousands of reviews ranks above a 5★ with a handful. The fewer the reviews, the more a rating is pulled towards the average.",
  "picks": {
   "best": "Top score",
   "budget": "Cheapest among products in the top 40% by score",
   "deal": "Among products priced below usual, the one furthest below its median (outliers and pick-a-variant listings excluded)"
  },
  "priceVerdict": "Prices are recorded daily and compared only with days on the same shipping terms. Under 7 days observed: insufficient_data. At the lowest observed price and at least 3% under the median: lowest_observed. At or under 90% of the median: below_usual. At or over 110%: above_usual. Otherwise usual. The window is up to 90 days and reported as window_days.",
  "caveat": "Specs are extracted mechanically from product titles and may be wrong. Check the product page before buying."
 },
