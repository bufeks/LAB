  "currency": "JPY",
  "store": "Rakuten Ichiba",
  "for_visitors": "Prices are in Japanese yen, tax included. Most Rakuten Ichiba shops ship only within Japan: from abroad, look for a shop that ships internationally or use a forwarding service. Manufacturer warranties on products bought in Japan are often valid only in Japan."
 },
 "how_to_choose": {
  "summary": "The type changes everything. For hygiene, steam (higher running cost); for low running cost, evaporative; for size and price, ultrasonic (only with regular cleaning). Choose a rated room size a step larger than your room.",
  "criteria": [
   {
    "name": "Steam",
    "detail": "Boils the water, so it is hygienic and humidifies strongly. Uses a few hundred watts, and some models have a hot outlet."
   },
   {
    "name": "Evaporative",
    "detail": "Blows air through a wet filter: low power and quiet. Output depends on room temperature and humidity, and the filter needs regular cleaning and replacement."
   },
   {
    "name": "Ultrasonic",
    "detail": "Cheap, small and quiet. It turns the water straight into mist, so a neglected tank spreads bacteria, and minerals in tap water can leave white dust."
   },
   {
    "name": "Hybrid",
    "detail": "Adds a heater to an evaporative or ultrasonic design to balance output and power use. More expensive."
   },
   {
    "name": "Room size",
    "detail": "Two figures are given, for a wooden Japanese-style room and a prefab Western-style room; the wooden-room figure is smaller. Compare using the one that matches your home."
   }
  ],
  "pitfalls": [
   "Check the price and availability of replacement filters (running cost) first.",
   "A tank with a narrow opening is hard to clean, which matters for hygiene."
  ],
  "abroad": "Made for Japan’s 100 V mains, and the manufacturer supports use in Japan only. 110–120 V is above its rating and can cause overheating or failure; never use it on 220–240 V."
 },
 "price_outlook": {
  "verdict": "usual",
  "share_cheaper": 0.17,
