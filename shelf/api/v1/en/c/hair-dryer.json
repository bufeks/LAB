 "market": {
  "country": "JP",
  "currency": "JPY",
  "store": "Rakuten Ichiba",
  "for_visitors": "Prices are in Japanese yen, tax included. Most Rakuten Ichiba shops ship only within Japan: from abroad, look for a shop that ships internationally or use a forwarding service. Manufacturer warranties on products bought in Japan are often valid only in Japan."
 },
 "how_to_choose": {
  "asOf": "2026-10",
  "summary": "How fast it dries is decided almost entirely by airflow (m³/min). For long or thick hair, choose a model with high airflow; if heat damage worries you, one with temperature switching. Ion-type features feel very different from person to person and are hard to compare by numbers.",
  "criteria": [
   {
    "name": "Airflow",
    "detail": "Typical models are around 1.3–1.5 m³/min, high-airflow models around 2 m³/min. The higher the airflow, the shorter the drying time and the less time your hair is exposed to heat."
   },
   {
    "name": "Temperature switching",
    "detail": "Air that is too hot strains hair and scalp. A low-temperature mode or hot/cool switching lets you adapt for finishing and for summer."
   },
   {
    "name": "Weight and shape",
    "detail": "You use it every day, so its weight and balance in the hand decide how happy you are with it. If you put it away, a foldable model."
   },
   {
    "name": "Ion-type features",
    "detail": "Features such as nanoe are each maker’s own technology, and how much difference people notice varies. Compare airflow and temperature control first, and treat extra features as a matter of preference."
   },
   {
    "name": "Power",
    "detail": "Most are around 1200 W, and using one together with other appliances can trip the breaker."
   }
  ],
  "pitfalls": [
   "Dust building up on the air intake reduces airflow and can cause overheating. Clean it regularly.",
   "Wrapping the cord around the body for storage can break the wires inside."
  ],
  "abroad": "Made for Japan’s 100 V mains, and the manufacturer supports use in Japan only. 110–120 V is above its rating and can cause overheating or failure; never use it on 220–240 V."
 },
 "price_outlook": {
