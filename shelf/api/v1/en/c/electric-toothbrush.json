  "for_visitors": "Prices are in Japanese yen, tax included. Most Rakuten Ichiba shops ship only within Japan: from abroad, look for a shop that ships internationally or use a forwarding service. Manufacturer warranties on products bought in Japan are often valid only in Japan."
 },
 "how_to_choose": {
  "summary": "Over time, replacement heads (changed about every 3 months) cost more than the handle. If you tend to brush too hard, get a pressure sensor; if you tend to miss spots, get a timer.",
  "criteria": [
   {
    "name": "Type",
    "detail": "Sonic brushes vibrate at high speed and are moved along the teeth. Rotating brushes have a round head that oscillates and is placed on one tooth at a time. Which is better comes down to preference and habit."
   },
   {
    "name": "Pressure sensor",
    "detail": "Pressing too hard can damage gums and teeth. A sensor that warns you helps."
   },
   {
    "name": "Timer",
    "detail": "A two-minute timer with a signal every 30 seconds to move on reduces missed spots."
   },
   {
    "name": "Replacement heads",
    "detail": "Usually replaced about every 3 months. Add the price of four genuine heads a year to the handle price when comparing."
   }
  ],
  "pitfalls": [
   "Third-party heads are cheaper but may void the manufacturer’s warranty."
  ],
  "abroad": "Many chargers sold in Japan are 100 V only; some accept 100–240 V. Check the charger label before using it abroad."
 },
