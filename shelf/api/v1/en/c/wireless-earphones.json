  "store": "Rakuten Ichiba",
  "for_visitors": "Prices are in Japanese yen, tax included. Most Rakuten Ichiba shops ship only within Japan: from abroad, look for a shop that ships internationally or use a forwarding service. Manufacturer warranties on products bought in Japan are often valid only in Japan."
 },
 "how_to_choose": {
  "summary": "If you commute or travel a lot, get noise cancelling; if you switch between a computer and a phone, prioritise multipoint. High-quality codecs depend on your phone (iPhone stops at AAC).",
  "criteria": [
   {
    "name": "Noise cancelling",
    "detail": "Makes the biggest difference on trains, planes and in cafés. Strength varies a lot between models, so models with many reviews are the safer bet."
   },
   {
    "name": "Codec",
    "detail": "iPhone does not support LDAC or aptX; it tops out at AAC. On an Android phone that supports LDAC or aptX, earbuds with the same codec sound better."
   },
   {
    "name": "Multipoint",
    "detail": "Connects to two devices at once, so you can take a phone call during a computer meeting without re-pairing."
   },
   {
    "name": "Water resistance",
    "detail": "IPX4 or better handles sweat and light rain. For sport, IPX5 or better."
   },
   {
    "name": "Battery life",
    "detail": "“Up to N hours” usually includes recharges from the case. Check how long the earbuds last on their own."
   }
  ],
  "pitfalls": [
   "Fit and isolation depend heavily on the shape of your ears. Check that ear tips in several sizes are included."
  ],
  "abroad": "Work anywhere. Charge them over USB."
 },
 "price_outlook": {
  "verdict": "cheaper_than_usual",
  "share_cheaper": 0.33,
  "share_pricier": 0,
