 "market": {
  "country": "JP",
  "currency": "JPY",
  "store": "Rakuten Ichiba",
  "for_visitors": "Prices are in Japanese yen, tax included. Most Rakuten Ichiba shops ship only within Japan: from abroad, look for a shop that ships internationally or use a forwarding service. Manufacturer warranties on products bought in Japan are often valid only in Japan."
 },
 "how_to_choose": {
  "asOf": "2026-10",
  "summary": "Mapping, which builds a map of your home, means fewer missed spots and lets you choose which rooms to clean. To cut the chores, choose auto-empty. Suction figures (Pa) are not measured the same way by every maker, so treat them as a rough guide only.",
  "criteria": [
   {
    "name": "Mapping",
    "detail": "Models that map the room with LiDAR (laser) or a camera move efficiently and let you set no-go zones and clean room by room."
   },
   {
    "name": "Height",
    "detail": "To clean under a sofa or bed, compare the gap under the furniture with the height of the robot."
   },
   {
    "name": "Auto-empty",
    "detail": "With models whose dock sucks out the dust, you only empty it once every few weeks. The dock is large, and dust bags cost money."
   },
   {
    "name": "Mopping",
    "detail": "Useful for mostly hard floors. If you have carpets, check whether it can lift its mop."
   },
   {
    "name": "Consumables",
    "detail": "Check the cost and availability of replacement brushes, filters and dust bags."
   }
  ],
  "pitfalls": [
   "It can get caught on cables and small objects on the floor. You need the habit of tidying the floor before it runs.",
   "For app-connected models, features may stop working if the maker ends the service."
  ],
  "abroad": "Before using it abroad, check whether the charging dock’s power adapter accepts 100–240 V; if it is 100 V only, do not use it on higher voltages."
 },
