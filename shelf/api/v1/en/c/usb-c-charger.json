 "market": {
  "country": "JP",
  "currency": "JPY",
  "store": "Rakuten Ichiba",
  "for_visitors": "Prices are in Japanese yen, tax included. Most Rakuten Ichiba shops ship only within Japan: from abroad, look for a shop that ships internationally or use a forwarding service. Manufacturer warranties on products bought in Japan are often valid only in Japan."
 },
 "how_to_choose": {
  "summary": "For a phone alone, 20–30 W; to charge a laptop too, 65 W or more. With several ports, the output per port drops when more than one device is plugged in.",
  "criteria": [
   {
    "name": "Output (W)",
    "detail": "Fast-charging an iPhone needs 20 W or more. For a laptop, match or exceed the wattage of its own adapter (for example 65 W or 96 W)."
   },
   {
    "name": "Sharing between ports",
    "detail": "A “65 W total” charger may split into 45 W + 20 W with two devices. If you charge a laptop and a phone together, check the split."
   },
   {
    "name": "PPS",
    "detail": "“Super fast charging” on Galaxy and similar phones needs a charger that supports USB PD PPS."
   },
   {
    "name": "GaN",
    "detail": "Gallium nitride chargers are smaller and lighter for the same output. Worth it if you carry one."
   },
   {
    "name": "Cable",
    "detail": "Above 60 W you need a 5 A (e-marked) USB-C cable. With a 3 A cable even a powerful charger stops at 60 W."
   }
  ],
  "pitfalls": [
   "Chargers without the PSE mark cannot be sold in Japan. Check for it.",
   "Comparing only the total output can hide a single port that is too weak."
  ],
  "abroad": "Most USB-C chargers sold in Japan accept 100–240 V input and work abroad with a plug adapter (Japan uses Type A, two flat pins). Check for “100-240V” on the label."
 },
 "price_outlook": {
  "verdict": "cheaper_than_usual",
