 "how_to_choose": {
  "asOf": "2026-10",
  "summary": "Click-on Sonicare brush heads fit most Sonicare rechargeable handles (Philips One and older Essence models are different). Compare by price per head. Replace about every 3 months.",
  "criteria": [
   {
    "name": "Fit with the handle",
    "detail": "According to the manufacturer, standard click-on brush heads fit most Sonicare rechargeable toothbrushes. Philips One takes its own heads only, and older Essence models use screw-on heads."
   },
   {
    "name": "Price per head",
    "detail": "Pack sizes differ (2, 4, 8 and so on), so divide by the number of heads. Larger packs are often cheaper."
   },
   {
    "name": "Head type",
    "detail": "There are types for different purposes, such as plaque removal, whitening and gum care. For everyday use, the standard type is enough."
   },
   {
    "name": "Genuine or third-party",
    "detail": "Only genuine heads are compared here. Third-party heads are cheaper but may void the manufacturer’s warranty."
   }
  ],
  "pitfalls": [
   "Replace the head before 3 months if the bristles start to splay.",
   "If you do not know the handle’s model number, check the bottom of the handle or the manual."
  ],
  "abroad": "Fit the same handles anywhere."
 },
