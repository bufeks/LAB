  "for_visitors": "Prices are in Japanese yen, tax included. Most Rakuten Ichiba shops ship only within Japan: from abroad, look for a shop that ships internationally or use a forwarding service. Manufacturer warranties on products bought in Japan are often valid only in Japan."
 },
 "how_to_choose": {
  "asOf": "2026-10",
  "summary": "Compare by price per 100 g. To keep the aroma longer, buy whole beans and grind just before brewing. If you like bitterness and body, dark roast; for acidity and aroma, light roast.",
  "criteria": [
   {
    "name": "Price per 100 g",
    "detail": "Sizes differ (200 g, 500 g × 2, 1 kg and so on), so divide by the total weight."
   },
   {
    "name": "Beans or ground",
    "detail": "Ground coffee has a large surface area and loses its aroma quickly. If you have a grinder, whole beans stay fresh longer."
   },
   {
    "name": "Roast",
    "detail": "Light roasts are acidic with a bright aroma; dark roasts are bitter with more body. Medium roasts are in between."
   },
   {
    "name": "Freshness",
    "detail": "Aroma fades with time after roasting. Choose listings that state the roast date, and once opened, keep them airtight and finish them soon."
   }
  ],
  "pitfalls": [
   "Large packs are cheaper, but the flavour fades before you finish them. As a guide, buy an amount you can drink within about a month."
  ],
  "abroad": "No special issue."
 },
