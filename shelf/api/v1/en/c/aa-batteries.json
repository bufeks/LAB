 "how_to_choose": {
  "asOf": "2026-10",
  "summary": "Compare by price per battery. For low-drain devices such as remote controls and clocks, cheap bulk packs are fine; for high-drain devices such as cameras and toys, consider high-performance batteries or rechargeables.",
  "criteria": [
   {
    "name": "Price per battery",
    "detail": "Pack sizes differ (4, 20, 40 and so on), so divide by the number of batteries."
   },
   {
    "name": "Recommended use-by period",
    "detail": "A guide to how long they keep from manufacture. For emergency stock, choose a long period and use them up and replace them within it."
   },
   {
    "name": "Use",
    "detail": "High-drain devices (game controllers, camera flashes and the like) run batteries down fast. If you change them often, rechargeable batteries can be cheaper in the long run."
   },
   {
    "name": "Leaks",
    "detail": "Removing dead batteries, and batteries from devices you will not use for a long time, prevents damage from leaks."
   }
  ],
  "pitfalls": [
   "Do not mix new and old batteries, or batteries of different types.",
   "When throwing them away, cover the terminals with tape and follow your municipality’s sorting rules."
  ],
  "abroad": "Work in any AA device. Alkaline batteries can go in your luggage; follow your airline’s rules."
 },
