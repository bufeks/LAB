 "how_to_choose": {
  "asOf": "2026-10",
  "summary": "比べるなら100gあたりの価格で。香りを長く楽しむなら豆のまま買って飲む直前に挽く。苦味とコクが好きなら深煎り、酸味と香りを楽しむなら浅煎り。",
  "criteria": [
   {
    "name": "100gあたり価格",
    "detail": "200g・500g×2・1kgなど容量が違うので、総量で割って比べる。"
   },
   {
    "name": "豆か粉か",
    "detail": "挽いた粉は表面積が大きく、香りが早く抜ける。ミルがあるなら豆のままのほうが鮮度を保ちやすい。"
   },
   {
    "name": "焙煎度",
    "detail": "浅煎りは酸味と華やかな香り、深煎りは苦味とコク。中煎りはその中間。"
   },
   {
    "name": "鮮度",
    "detail": "焙煎後は時間とともに香りが落ちる。焙煎日が書かれた商品を選び、開封後は密閉して早めに飲み切る。"
   }
  ],
  "pitfalls": [
   "大容量は割安でも、飲み切るまでに風味が落ちる。1か月程度で飲み切れる量が目安。"
  ]
 },
 "price_outlook": {
  "verdict": "cheaper_than_usual",
  "share_cheaper": 0.33,
