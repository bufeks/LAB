 "market": {
  "country": "JP",
  "currency": "JPY",
  "store": "Rakuten Ichiba",
  "for_visitors": "가격은 엔화, 세금 포함입니다. 라쿠텐 이치바의 대부분 상점은 일본 국내로만 배송합니다. 해외에서는 해외 배송을 하는 상점을 찾거나 배송 대행 서비스를 이용하세요. 일본에서 산 제품의 제조사 보증은 일본 안에서만 유효한 경우가 많습니다."
 },
 "how_to_choose": {
  "asOf": "2026-09",
  "summary": "평소에 쓰려면 10,000mAh·20W 이상, 노트북까지 충전하려면 20,000mAh·45W 이상이 기준. 일본에서 파는 보조배터리는 PSE 마크가 필수다. 비행기에는 기내 반입만 되고, 100Wh를 넘으면 항공사 승인이 필요하며, 기내 사용·충전을 금지하는 항공사도 많다.",
  "criteria": [
   {
    "name": "용량 (mAh)",
    "detail": "전압 변환 손실 때문에 표시 용량 중 실제로 스마트폰에 들어가는 것은 약 60~70%. 10,000mAh로 일반 스마트폰을 약 1.5~2회 충전할 수 있다."
   },
   {
    "name": "출력 (W)",
    "detail": "iPhone 고속 충전은 USB PD 20W 이상. 노트북은 정품 어댑터에 가까운 와트(45~65W 이상)가 필요하다."
   },
   {
    "name": "무게",
    "detail": "10,000mAh급은 약 180~250g, 20,000mAh급은 약 300~450g. 들고 다닐 거라면 용량보다 무게로 먼저 좁힌다."
   },
   {
    "name": "PSE 마크",
    "detail": "2019년 2월부터 PSE 마크가 없는 보조배터리는 일본에서 판매할 수 없다(전기용품안전법). 표기가 없는 상품은 피한다."
   },
   {
    "name": "비행기",
    "detail": "위탁 수하물 불가, 기내 반입만 가능. 일반 기준은 100Wh 이하 승인 불필요, 100Wh 초과 160Wh 이하는 항공사 승인 필요(보통 2개까지), 160Wh 초과는 반입 불가. 2025년 이후 기내 사용·충전을 금지하거나 개수를 제한하는 항공사가 늘었고, 일본 국내선에서는 선반이 아니라 몸 가까이에 두도록 요구한다. 본체의 Wh 표기를 확인하고(20,000mAh는 약 74Wh, 27,000mAh급은 100Wh 전후라 확인 필요) 이용하는 항공사의 최신 규정을 확인한다."
   }
  ],
  "pitfalls": [
   "시세보다 지나치게 싼 대용량 제품은 용량 표기가 부풀려져 있을 수 있다.",
   "부풀거나 뜨거워지거나 냄새가 나면 사용을 멈추고 지자체나 JBRC 협력점 수거함에 낸다(일반 쓰레기로 버리지 않는다)."
  ],
  "abroad": "어디서나 쓸 수 있다(USB). 비행기로 가져갈 때는 반드시 기내 반입하고, 본체의 Wh 표기를 확인한다."
 },
 "price_outlook": {
  "verdict": "usual",
  "share_cheaper": 0.17,
  "share_pricier": 0,
  "judged_items": 6,
  "window_days": 31,
  "summary": "대체로 평소 가격대. 기다린다고 크게 싸질 조짐은 없다. (31일 관측, 계절 변동은 아직 반영되지 않음)"
 },
 "method": {
  "summary": "카테고리마다 라쿠텐에서 리뷰 수 순으로 최대 60개를 가져와 제외어·가격대·최소 리뷰 수로 거른다. 여러 상점이 파는 같은 상품(모델명이 같거나, 사양이 같고 상품명이 거의 같은 것)은 평점이 가장 높은 하나로 합치고, 다른 상점 가격은 other_offers에 남긴다. 나머지를 “베이즈 평균 평점”으로 정렬한다.",
  "formula": "score = (C × m + n × r) / (C + n)  … r = 해당 상품 평균 평점, n = 리뷰 수, m = 전체 후보의 평균 평점, C = 50",
  "why": "리뷰 몇 건의 ★5보다 리뷰 수천 건의 ★4.4를 위에 두기 위해서다. 리뷰가 적을수록 평점이 전체 평균 쪽으로 당겨진다.",
  "picks": {
   "best": "점수 1위",
   "budget": "점수 상위 40% 상품 중 최저가",
   "deal": "평소보다 싼 상품 중 중앙값 대비 하락 폭이 가장 큰 것 (이상값과 옵션 선택형 상품 제외)"
  },
  "priceVerdict": "매일 가격을 기록하고, 배송 조건이 같은 날끼리만 비교한다. 관측 7일 미만은 insufficient_data, 관측 기간 최저가이면서 중앙값보다 3% 이상 싸면 lowest_observed, 중앙값의 90% 이하면 below_usual, 110% 이상이면 above_usual, 그 외는 usual. 관측 기간은 최대 90일이며 window_days에 표시한다.",
  "caveat": "사양은 상품명에서 기계적으로 추출한 참고값이라 틀릴 수 있다. 구매 전에 상품 페이지에서 확인할 것."
 },
