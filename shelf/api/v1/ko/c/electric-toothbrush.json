 "market": {
  "country": "JP",
  "currency": "JPY",
  "store": "Rakuten Ichiba",
  "for_visitors": "가격은 엔화, 세금 포함입니다. 라쿠텐 이치바의 대부분 상점은 일본 국내로만 배송합니다. 해외에서는 해외 배송을 하는 상점을 찾거나 배송 대행 서비스를 이용하세요. 일본에서 산 제품의 제조사 보증은 일본 안에서만 유효한 경우가 많습니다."
 },
 "how_to_choose": {
  "summary": "길게 보면 본체보다 교체용 칫솔모(약 3개월마다 교체) 비용이 더 크다. 너무 세게 닦을까 걱정이면 과압 방지 센서, 덜 닦일까 걱정이면 타이머가 있는 제품.",
  "criteria": [
   {
    "name": "방식",
    "detail": "음파식은 칫솔모를 고속으로 진동시켜 치아를 따라 움직인다. 회전식은 둥근 헤드가 왕복 회전하며 한 개씩 대고 닦는다. 어느 쪽이 나은지는 취향과 습관에 따라 다르다."
   },
   {
    "name": "과압 방지 센서",
    "detail": "너무 세게 누르면 잇몸과 치아가 상하기 쉽다. 센서로 알려 주면 안심된다."
   },
   {
    "name": "타이머",
    "detail": "2분 타이머와 30초마다 닦을 곳을 바꾸라는 신호가 있으면 덜 닦이는 곳이 줄어든다."
   },
   {
    "name": "교체용 칫솔모",
    "detail": "보통 3개월마다 교체한다. 정품 칫솔모 1개 가격 × 연 4개를 본체 가격에 더해 비교한다."
   }
  ],
  "pitfalls": [
   "호환 칫솔모는 싸지만 제조사 보증 대상에서 빠질 수 있다."
  ],
  "abroad": "일본에서 파는 충전기 중에는 100V 전용이 많고, 100~240V를 지원하는 것도 있다. 해외에서 쓰기 전에 충전기 라벨을 확인한다."
 },
 "price_outlook": {
  "verdict": "cheaper_than_usual",
  "share_cheaper": 0.33,
  "share_pricier": 0,
  "judged_items": 6,
  "window_days": 31,
  "summary": "상위 상품의 33%가 평소보다 싸다. 사기에 나쁘지 않은 시기. (31일 관측, 계절 변동은 아직 반영되지 않음)"
 },
 "method": {
  "summary": "카테고리마다 라쿠텐에서 리뷰 수 순으로 최대 60개를 가져와 제외어·가격대·최소 리뷰 수로 거른다. 여러 상점이 파는 같은 상품(모델명이 같거나, 사양이 같고 상품명이 거의 같은 것)은 평점이 가장 높은 하나로 합치고, 다른 상점 가격은 other_offers에 남긴다. 나머지를 “베이즈 평균 평점”으로 정렬한다.",
  "formula": "score = (C × m + n × r) / (C + n)  … r = 해당 상품 평균 평점, n = 리뷰 수, m = 전체 후보의 평균 평점, C = 50",
  "why": "리뷰 몇 건의 ★5보다 리뷰 수천 건의 ★4.4를 위에 두기 위해서다. 리뷰가 적을수록 평점이 전체 평균 쪽으로 당겨진다.",
  "picks": {
   "best": "점수 1위",
   "budget": "점수 상위 40% 상품 중 최저가",
   "deal": "평소보다 싼 상품 중 중앙값 대비 하락 폭이 가장 큰 것 (이상값과 옵션 선택형 상품 제외)"
  },
  "priceVerdict": "매일 가격을 기록하고, 배송 조건이 같은 날끼리만 비교한다. 관측 7일 미만은 insufficient_data, 관측 기간 최저가이면서 중앙값보다 3% 이상 싸면 lowest_observed, 중앙값의 90% 이하면 below_usual, 110% 이상이면 above_usual, 그 외는 usual. 관측 기간은 최대 90일이며 window_days에 표시한다.",
  "caveat": "사양은 상품명에서 기계적으로 추출한 참고값이라 틀릴 수 있다. 구매 전에 상품 페이지에서 확인할 것."
 },
