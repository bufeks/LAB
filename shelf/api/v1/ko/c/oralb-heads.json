 "how_to_choose": {
  "asOf": "2026-10",
  "summary": "브라운 오랄비 원형 칫솔모는 iO 시리즈를 제외한 회전식 본체에 쓸 수 있다(iO는 전용 칫솔모만, 타원형은 다른 기종용). 비교는 1개당 가격으로. 약 3개월마다 교체하는 것이 기준.",
  "criteria": [
   {
    "name": "본체와의 호환",
    "detail": "제조사에 따르면 교체용 칫솔모는 브라운(오랄비) 전동칫솔 본체에 끼울 수 있지만, iO 시리즈에는 전용 칫솔모가 있어 호환되지 않는다. 원형과 타원형은 맞는 본체가 다르다."
   },
   {
    "name": "1개당 가격",
    "detail": "개수가 다르므로 개수로 나눠 비교한다."
   },
   {
    "name": "칫솔모 종류",
    "detail": "치석 제거·미백·부드러운 타입 등이 있다. 잇몸이 약한 사람은 부드러운 타입을 고른다."
   },
   {
    "name": "정품이냐 호환품이냐",
    "detail": "여기서는 정품만 비교한다. 호환품은 싸지만 제조사 보증 대상에서 빠질 수 있다."
   }
  ],
  "pitfalls": [
   "칫솔모 뿌리 쪽 색깔 있는 솔이 옅어지면 교체 신호다(인디케이터가 있는 칫솔모의 경우)."
  ],
  "abroad": "칫솔모는 어느 나라에서든 같은 본체에 맞는다."
 },
 "price_outlook": {
