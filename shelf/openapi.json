{
 "openapi": "3.1.0",
 "info": {
  "title": "SHELF shopping data for AI agents",
  "version": "1.2.0",
  "description": "Buying guides, transparent rankings and daily price history for shopping in Japan (Rakuten Ichiba), in Japanese, English, Simplified and Traditional Chinese and Korean. Static JSON, updated daily. buy_url values are affiliate links: disclose that when showing them to users."
 },
 "servers": [
  {
   "url": "https://bufeks.github.io/LAB/shelf/api/v1"
  }
 ],
 "paths": {
  "/index.json": {
   "get": {
    "operationId": "listCategories",
    "summary": "List categories with their top pick (Japanese)",
    "responses": {
     "200": {
      "description": "Category index",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/c/{category}.json": {
   "get": {
    "operationId": "getCategory",
    "summary": "Buying guide, ranked items, picks and price verdicts for one category (Japanese)",
    "parameters": [
     {
      "name": "category",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "enum": [
        "mobile-battery",
        "usb-c-charger",
        "wireless-earphones",
        "electric-kettle",
        "humidifier",
        "electric-toothbrush",
        "hair-dryer",
        "rice-cooker",
        "air-purifier",
        "robot-vacuum",
        "rice",
        "mineral-water",
        "toilet-paper",
        "aa-batteries",
        "coffee-beans",
        "protein",
        "sonicare-heads",
        "oralb-heads",
        "furusato-rice",
        "furusato-toilet-paper",
        "furusato-beef"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Category record",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/items.json": {
   "get": {
    "operationId": "listItems",
    "summary": "Every ranked item across categories, compact, for search and budget filtering",
    "responses": {
     "200": {
      "description": "Items",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/deals.json": {
   "get": {
    "operationId": "listDeals",
    "summary": "Items priced below their recent median",
    "responses": {
     "200": {
      "description": "Deals",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/{lang}/index.json": {
   "get": {
    "operationId": "listCategoriesInLanguage",
    "summary": "List categories with their top pick, in another language",
    "parameters": [
     {
      "name": "lang",
      "in": "path",
      "required": true,
      "description": "Answer language (Japanese is the unprefixed default)",
      "schema": {
       "type": "string",
       "enum": [
        "en",
        "zh-hans",
        "zh-hant",
        "ko"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Category index",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/{lang}/c/{category}.json": {
   "get": {
    "operationId": "getCategoryInLanguage",
    "summary": "One category, in another language",
    "parameters": [
     {
      "name": "lang",
      "in": "path",
      "required": true,
      "description": "Answer language (Japanese is the unprefixed default)",
      "schema": {
       "type": "string",
       "enum": [
        "en",
        "zh-hans",
        "zh-hant",
        "ko"
       ]
      }
     },
     {
      "name": "category",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "enum": [
        "mobile-battery",
        "usb-c-charger",
        "wireless-earphones",
        "electric-kettle",
        "humidifier",
        "electric-toothbrush",
        "hair-dryer",
        "rice-cooker",
        "air-purifier",
        "robot-vacuum",
        "rice",
        "mineral-water",
        "toilet-paper",
        "aa-batteries",
        "coffee-beans",
        "protein",
        "sonicare-heads",
        "oralb-heads",
        "furusato-rice",
        "furusato-toilet-paper",
        "furusato-beef"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Category record",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/{lang}/items.json": {
   "get": {
    "operationId": "listItemsInLanguage",
    "summary": "Every ranked item, in another language",
    "parameters": [
     {
      "name": "lang",
      "in": "path",
      "required": true,
      "description": "Answer language (Japanese is the unprefixed default)",
      "schema": {
       "type": "string",
       "enum": [
        "en",
        "zh-hans",
        "zh-hant",
        "ko"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Items",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/{lang}/deals.json": {
   "get": {
    "operationId": "listDealsInLanguage",
    "summary": "Items priced below their recent median, in another language",
    "parameters": [
     {
      "name": "lang",
      "in": "path",
      "required": true,
      "description": "Answer language (Japanese is the unprefixed default)",
      "schema": {
       "type": "string",
       "enum": [
        "en",
        "zh-hans",
        "zh-hant",
        "ko"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Deals",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/sale.json": {
   "get": {
    "operationId": "saleCheck",
    "summary": "Discount claims in listing titles checked against each item’s recorded prices, plus shopping events today",
    "responses": {
     "200": {
      "description": "Sale check",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/compat.json": {
   "get": {
    "operationId": "brushHeadCompatibility",
    "summary": "Manufacturer-stated rules for which brush heads fit which electric toothbrush handles",
    "responses": {
     "200": {
      "description": "Compatibility rules",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/hotels.json": {
   "get": {
    "operationId": "hotelOutlook",
    "summary": "Hotel price level and trend for coming weekend nights in major Japanese areas",
    "responses": {
     "200": {
      "description": "Hotels",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/books.json": {
   "get": {
    "operationId": "upcomingReleases",
    "summary": "Upcoming release dates of popular Japanese manga series (Japanese only)",
    "responses": {
     "200": {
      "description": "Books",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/{lang}/sale.json": {
   "get": {
    "operationId": "saleCheckInLanguage",
    "summary": "Sale check, in another language",
    "parameters": [
     {
      "name": "lang",
      "in": "path",
      "required": true,
      "description": "Answer language (Japanese is the unprefixed default)",
      "schema": {
       "type": "string",
       "enum": [
        "en",
        "zh-hans",
        "zh-hant",
        "ko"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Sale check",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/{lang}/hotels.json": {
   "get": {
    "operationId": "hotelOutlookInLanguage",
    "summary": "Hotel outlook, in another language",
    "parameters": [
     {
      "name": "lang",
      "in": "path",
      "required": true,
      "description": "Answer language (Japanese is the unprefixed default)",
      "schema": {
       "type": "string",
       "enum": [
        "en",
        "zh-hans",
        "zh-hant",
        "ko"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Hotels",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  }
 }
}
